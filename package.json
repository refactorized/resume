{
  "name": "refactorized-resume",
  "version": "1.0.1",
  "description": "",
  "main": "cat README.md",
  "scripts": {
    "test": "echo 'ALL ZERO(0) TESTS PASSED!!!'",
    "serve": "eleventy --serve",
    "dev": "rimraf _site; eleventy --serve",
    "build-all": "rimraf _build _site; node src/build.js",
    "build": "node src/build.js",
    "audit": "node src/audit.js --expect resume=1,resume-full=3,resume-comprehensive=3,resume-recent=2",
    "audit-all": "npm run audit -- --validate",
    "probe": "node src/probe.js"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@11ty/eleventy": "3.0.0-alpha.13",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "chalk": "^5.3.0",
    "code-tag": "^1.2.0",
    "commander": "^12.1.0",
    "fast-safe-stringify": "^2.1.1",
    "js-yaml": "^4.1.0",
    "jsonfile": "^6.1.0",
    "markdown-it": "^14.1.0",
    "markdown-it-attrs": "^4.1.6",
    "markdown-it-container": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "mkdirp": "^3.0.1",
    "open-props": "^1.7.5",
    "playwright": "^1.62.0",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.md",
        "options": {
          "printWidth": 100,
          "proseWrap": "always"
        }
      },
      {
        "files": [
          "*.webc"
        ],
        "options": {
          "parser": "html"
        }
      }
    ]
  },
  "type": "module",
  "devDependencies": {
    "pdf-lib": "^1.17.1"
  }
}
